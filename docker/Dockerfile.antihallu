FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

WORKDIR /app

COPY docker/requirements-antihallu.txt .
RUN pip install --no-cache-dir -r requirements-antihallu.txt

COPY servers/antihallu/server.py servers/antihallu/medgemma_detector.py /app/
COPY servers/antihallu/examples.json servers/antihallu/cache.json /app/
COPY servers/antihallu/calibration/ /app/calibration/

EXPOSE 8000

CMD ["python", "server.py"]
