<?xml version="1.0" encoding="UTF-8"?>
<!--
  ICH ICSR v2.1 — Subset XSD for PharmaGemma Doc Agent.
  Validates the E2B(R2)-style XML generated by e2b_converter.py.
  Covers all elements produced by the converter; not the full ICH schema.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">

  <!-- ================================================================ -->
  <!-- Root: ichicsr                                                     -->
  <!-- ================================================================ -->
  <xs:element name="ichicsr">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ichicsrmessageheader" type="MessageHeaderType"/>
        <xs:element name="safetyreport" type="SafetyReportType" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="lang" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- N: Transmission Headers                                           -->
  <!-- ================================================================ -->
  <xs:complexType name="MessageHeaderType">
    <xs:sequence>
      <xs:element name="messagetype" type="xs:string"/>
      <xs:element name="messageformatversion" type="xs:string"/>
      <xs:element name="messageformatrelease" type="xs:string"/>
      <xs:element name="messagenumb" type="xs:string"/>
      <xs:element name="messagesenderidentifier" type="xs:string"/>
      <xs:element name="messagereceiveridentifier" type="xs:string"/>
      <xs:element name="messagedateformat" type="xs:string"/>
      <xs:element name="messagedate" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- Safety Report (one per case)                                      -->
  <!-- ================================================================ -->
  <xs:complexType name="SafetyReportType">
    <xs:sequence>
      <!-- C.1: Case Identification -->
      <xs:element name="safetyreportversion" type="xs:string"/>
      <xs:element name="safetyreportid" type="xs:string"/>
      <xs:element name="primarysourcecountry" type="xs:string"/>
      <xs:element name="occurcountry" type="xs:string"/>
      <xs:element name="transmissiondateformat" type="xs:string"/>
      <xs:element name="transmissiondate" type="xs:string"/>
      <xs:element name="reporttype" type="xs:string"/>
      <xs:element name="serious" type="xs:string"/>

      <!-- Seriousness criteria (conditional) -->
      <xs:element name="seriousnessdeath" type="xs:string" minOccurs="0"/>
      <xs:element name="seriousnesslifethreatening" type="xs:string" minOccurs="0"/>
      <xs:element name="seriousnesshospitalization" type="xs:string" minOccurs="0"/>
      <xs:element name="seriousnessdisabling" type="xs:string" minOccurs="0"/>
      <xs:element name="seriousnesscongenitalanomali" type="xs:string" minOccurs="0"/>
      <xs:element name="seriousnessother" type="xs:string" minOccurs="0"/>

      <!-- Receipt dates -->
      <xs:element name="receivedateformat" type="xs:string"/>
      <xs:element name="receivedate" type="xs:string"/>
      <xs:element name="receiptdateformat" type="xs:string"/>
      <xs:element name="receiptdate" type="xs:string"/>
      <xs:element name="fulfilexpeditecriteria" type="xs:string"/>

      <!-- C.2: Primary Source -->
      <xs:element name="primarysource" type="PrimarySourceType"/>

      <!-- C.3: Sender -->
      <xs:element name="sender" type="SenderType"/>

      <!-- C.4: Receiver -->
      <xs:element name="receiver" type="ReceiverType"/>

      <!-- C.5: Duplicate / Study -->
      <xs:element name="reportduplicate" type="ReportDuplicateType"/>
      <xs:element name="studyregistration" type="StudyRegistrationType"/>

      <!-- IND -->
      <xs:element name="authoritynumb" type="xs:string" minOccurs="0"/>
      <xs:element name="companynumb" type="xs:string" minOccurs="0"/>

      <!-- D: Patient -->
      <xs:element name="patient" type="PatientType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- C.2: Primary Source                                               -->
  <!-- ================================================================ -->
  <xs:complexType name="PrimarySourceType">
    <xs:sequence>
      <xs:element name="reportergivename" type="xs:string"/>
      <xs:element name="qualification" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- C.3: Sender                                                       -->
  <!-- ================================================================ -->
  <xs:complexType name="SenderType">
    <xs:sequence>
      <xs:element name="sendertype" type="xs:string"/>
      <xs:element name="senderorganization" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- C.4: Receiver                                                     -->
  <!-- ================================================================ -->
  <xs:complexType name="ReceiverType">
    <xs:sequence>
      <xs:element name="receivertype" type="xs:string"/>
      <xs:element name="receiverorganization" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- Report Duplicate                                                  -->
  <!-- ================================================================ -->
  <xs:complexType name="ReportDuplicateType">
    <xs:sequence>
      <xs:element name="duplicatesource" type="xs:string"/>
      <xs:element name="duplicatenumb" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- Study Registration                                                -->
  <!-- ================================================================ -->
  <xs:complexType name="StudyRegistrationType">
    <xs:sequence>
      <xs:element name="studyregistrationnumb" type="xs:string"/>
      <xs:element name="studyregistrationcountry" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- D: Patient                                                        -->
  <!-- ================================================================ -->
  <xs:complexType name="PatientType">
    <xs:sequence>
      <xs:element name="patientinitial" type="xs:string"/>

      <!-- D.2: Age -->
      <xs:element name="patientonsetage" type="xs:string" minOccurs="0"/>
      <xs:element name="patientonsetageunit" type="xs:string" minOccurs="0"/>

      <!-- D.3: Birth date -->
      <xs:element name="patientbirthdateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="patientbirthdate" type="xs:string" minOccurs="0"/>

      <!-- D.4: Weight and Height -->
      <xs:element name="patientweight" type="xs:string" minOccurs="0"/>
      <xs:element name="patientheight" type="xs:string" minOccurs="0"/>

      <!-- D.5: Sex -->
      <xs:element name="patientsex" type="xs:string" minOccurs="0"/>

      <!-- D.7: Medical History (repeating) -->
      <xs:element name="medicalhistoryepisode" type="MedicalHistoryType"
                  minOccurs="0" maxOccurs="unbounded"/>

      <!-- D.9: Death -->
      <xs:element name="patientdeathdateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="patientdeathdate" type="xs:string" minOccurs="0"/>
      <xs:element name="patientdeathcause" type="DeathCauseType" minOccurs="0"/>
      <xs:element name="patientautopsyyesno" type="xs:string" minOccurs="0"/>

      <!-- E.i: Reaction/Event -->
      <xs:element name="reaction" type="ReactionType"/>

      <!-- F.r: Tests/Procedures (repeating) -->
      <xs:element name="test" type="TestType"
                  minOccurs="0" maxOccurs="unbounded"/>

      <!-- G.k: Drug Information (repeating, at least 1) -->
      <xs:element name="drug" type="DrugType"
                  maxOccurs="unbounded"/>

      <!-- H: Narrative -->
      <xs:element name="summary" type="SummaryType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- D.7: Medical History Episode                                      -->
  <!-- ================================================================ -->
  <xs:complexType name="MedicalHistoryType">
    <xs:sequence>
      <xs:element name="patientepisodename" type="xs:string"/>
      <xs:element name="patientmedicalstartdateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="patientmedicalstartdate" type="xs:string" minOccurs="0"/>
      <xs:element name="patientmedicalcontinue" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- D.9: Death Cause                                                  -->
  <!-- ================================================================ -->
  <xs:complexType name="DeathCauseType">
    <xs:sequence>
      <xs:element name="patientdeathreport" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- E.i: Reaction/Event                                               -->
  <!-- ================================================================ -->
  <xs:complexType name="ReactionType">
    <xs:sequence>
      <xs:element name="primarysourcereaction" type="xs:string"/>
      <xs:element name="reactionmeddraversionllt" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionmeddrallt" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionmeddraversionpt" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionmeddrapt" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionstartdateformat" type="xs:string"/>
      <xs:element name="reactionstartdate" type="xs:string"/>
      <xs:element name="reactionenddateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionenddate" type="xs:string" minOccurs="0"/>
      <xs:element name="reactionoutcome" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- F.r: Test/Procedure                                               -->
  <!-- ================================================================ -->
  <xs:complexType name="TestType">
    <xs:sequence>
      <xs:element name="testdateformat" type="xs:string"/>
      <xs:element name="testdate" type="xs:string"/>
      <xs:element name="testname" type="xs:string"/>
      <xs:element name="testresult" type="xs:string"/>
      <xs:element name="testunit" type="xs:string" minOccurs="0"/>
      <xs:element name="lowtestrange" type="xs:string" minOccurs="0"/>
      <xs:element name="hightestrange" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- G.k: Drug Information                                             -->
  <!-- ================================================================ -->
  <xs:complexType name="DrugType">
    <xs:sequence>
      <xs:element name="drugcharacterization" type="xs:string"/>
      <xs:element name="medicinalproduct" type="xs:string"/>
      <xs:element name="drugstructuredosagenumb" type="xs:string" minOccurs="0"/>
      <xs:element name="drugdosagetext" type="xs:string" minOccurs="0"/>
      <xs:element name="drugadministrationroute" type="xs:string" minOccurs="0"/>
      <xs:element name="drugstartdateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="drugstartdate" type="xs:string" minOccurs="0"/>
      <xs:element name="drugenddateformat" type="xs:string" minOccurs="0"/>
      <xs:element name="drugenddate" type="xs:string" minOccurs="0"/>
      <xs:element name="drugindication" type="xs:string" minOccurs="0"/>
      <xs:element name="actiondrug" type="xs:string" minOccurs="0"/>
      <xs:element name="drugrecurreadministration" type="xs:string" minOccurs="0"/>
      <xs:element name="drugbatchnumb" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- H: Narrative Summary                                              -->
  <!-- ================================================================ -->
  <xs:complexType name="SummaryType">
    <xs:sequence>
      <xs:element name="narrativeincludeclinical" type="xs:string"/>
      <xs:element name="reportercomment" type="xs:string" minOccurs="0"/>
      <xs:element name="senderdiagnosis" type="SenderDiagnosisType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================================================================ -->
  <!-- H.3: Sender Diagnosis                                             -->
  <!-- ================================================================ -->
  <xs:complexType name="SenderDiagnosisType">
    <xs:sequence>
      <xs:element name="senderdiagnosismeddraversion" type="xs:string"/>
      <xs:element name="senderdiagnosis" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
